{
  "entity": {
    "calendar": {
      "expected_deliveries": {
        "default": "mdi:calendar-clock"
      }
    },
    "sensor": {
      "active_shipments": {
        "default": "mdi:package-variant-closed"
      },
      "all_shipments": {
        "default": "mdi:package-variant"
      },
      "expected_today": {
        "default": "mdi:calendar-today"
      },
      "out_for_delivery": {
        "default": "mdi:truck-delivery"
      },
      "ready_for_pickup": {
        "default": "mdi:store-marker"
      },
      "delivered_today": {
        "default": "mdi:package-variant-closed-check"
      },
      "problems": {
        "default": "mdi:package-variant-closed-remove"
      },
      "carrier": {
        "default": "mdi:truck-fast"
      },
      "destination": {
        "default": "mdi:home-import-outline"
      },
      "last_update": {
        "default": "mdi:update"
      },
      "sources": {
        "default": "mdi:email-sync",
        "state": {
          "pending": "mdi:email-clock",
          "ok": "mdi:email-check",
          "error": "mdi:email-alert",
          "auth_failed": "mdi:email-lock",
          "failed": "mdi:email-remove"
        }
      }
    }
  },
  "services": {
    "get_shipments": {
      "service": "mdi:package-variant-closed"
    },
    "add_shipment": {
      "service": "mdi:package-variant-plus"
    },
    "remove_shipment": {
      "service": "mdi:package-variant-remove"
    },
    "mark_delivered": {
      "service": "mdi:package-variant-closed-check"
    },
    "refresh": {
      "service": "mdi:refresh"
    },
    "test_parser": {
      "service": "mdi:test-tube"
    }
  }
}
